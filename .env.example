# ============================================================
# MPC-IEMS — MISRAK POLYTECHNIC COLLEGE
# Environment Configuration Template
# ============================================================
#
# USAGE:
#   1. Copy this file to `.env` (no "example" suffix):
#        Linux/macOS:  cp .env.example .env
#        Windows:      copy .env.example .env
#
#   2. Edit `.env` with the real credentials for this server.
#
#   3. NEVER commit `.env` to Git. It is listed in .gitignore.
#
#   4. If `.env` does not exist, `config.php` uses hardcoded
#      XAMPP defaults — so local development works with zero
#      configuration. `.env` is only required in production.
#
# ============================================================


# ------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------
# Controls error display, debug panels, and logging behavior.
#
#   development  →  errors visible in browser, dev quick-login
#                   panel shown on login.php, verbose error pages
#
#   production   →  errors logged to logs/error.log only,
#                   generic error messages shown to users,
#                   dev panels hidden
#
# NEVER ship production with APP_ENV=development.
# ------------------------------------------------------------
APP_ENV=development


# ------------------------------------------------------------
# 2. APPLICATION URL
# ------------------------------------------------------------
# Base URL used to build all links, redirect targets, and
# asset paths throughout the app.
#
# LEAVE THIS COMMENTED OUT unless auto-detection fails.
# `config.php` automatically detects the URL from the request:
#
#   http://localhost/mpc-iems       →  detected correctly
#   http://localhost:8080/mpc_iems  →  detected correctly
#   https://misrak.edu.et           →  detected correctly
#   https://misrak.edu.et/iems      →  detected correctly
#
# You need to UNCOMMENT and set this ONLY in these cases:
#
#   - Behind a reverse proxy (nginx → Apache, Cloudflare, etc.)
#     that hides the original protocol
#   - Behind a CDN that rewrites the Host header
#   - The auto-detected URL is wrong (rare)
#
# Format: no trailing slash.
# ------------------------------------------------------------
# APP_URL=https://misrak.edu.et


# ------------------------------------------------------------
# 3. DATABASE CONNECTION
# ------------------------------------------------------------
# MySQL / MariaDB credentials.
#
# LOCAL (XAMPP defaults — you can delete this whole section
# and config.php will use these values automatically):
# ------------------------------------------------------------
DB_HOST=localhost
DB_NAME=mpc_iems
DB_USER=root
DB_PASS=


# ------------------------------------------------------------
# PRODUCTION DATABASE (uncomment and fill in when deploying)
# ------------------------------------------------------------
# Create a dedicated MySQL user — NEVER use root in production.
#
#   CREATE USER 'mpc_iems_user'@'localhost'
#     IDENTIFIED BY 'STRONG_RANDOM_PASSWORD_HERE';
#   GRANT SELECT, INSERT, UPDATE, DELETE
#     ON mpc_iems.* TO 'mpc_iems_user'@'localhost';
#   GRANT EXECUTE ON mpc_iems.* TO 'mpc_iems_user'@'localhost';
#   FLUSH PRIVILEGES;
#
# Note: EXECUTE is required because the app calls stored
# procedures (sp_create_clearance, sp_approve_step, etc.)
# ------------------------------------------------------------
# DB_HOST=localhost
# DB_NAME=mpc_iems
# DB_USER=mpc_iems_user
# DB_PASS=CHANGE_ME_TO_A_LONG_RANDOM_STRING


# ------------------------------------------------------------
# 4. OPTIONAL — FUTURE FEATURES
# ------------------------------------------------------------
# These variables are NOT yet read by config.php.
# They are documented here so future features can pick them
# up without changing the .env format.
# ------------------------------------------------------------

# ---- Email / SMTP (for notifications, password resets) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=misrakptc961@gmail.com
# SMTP_PASS=app-specific-password-here
# SMTP_FROM_NAME=Misrak Polytechnic College
# SMTP_ENCRYPTION=tls

# ---- Backup retention (for admin/backup.php) ----
# BACKUP_KEEP_DAYS=30
# BACKUP_KEEP_WEEKLY=12
# BACKUP_KEEP_MONTHLY=12

# ---- File upload limits ----
# MAX_UPLOAD_MB=10

# ---- Session lifetime in seconds ----
# SESSION_LIFETIME=7200


# ------------------------------------------------------------
# 5. SECURITY REMINDERS
# ------------------------------------------------------------
# ☑ Ensure .env is listed in .gitignore
# ☑ Set file permissions to 600 (owner-only) on Linux:
#       chmod 600 .env
# ☑ Confirm .htaccess blocks HTTP access to .env:
#       curl -I https://misrak.edu.et/.env
#       → should return 403 Forbidden
# ☑ Never email or Slack the contents of .env
# ☑ Rotate the DB password if it ever leaks
#
# ============================================================
# END OF FILE
# ============================================================