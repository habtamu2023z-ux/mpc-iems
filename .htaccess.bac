# ============================================================
# MPC-IEMS — Uploads Directory
# Blocks PHP execution inside uploads — even if a bad file
# gets through, Apache will refuse to run it.
# ============================================================

# 1. No script execution
<FilesMatch "\.(php\d?|phtml|phar|pl|py|jsp|asp|aspx|sh|cgi|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. No directory listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 3. Strip PHP handler just in case
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 4. Deny direct access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>